<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <record model="ir.module.category" id="technortal_hms.module_groups">
            <field name="name">
                HOtel Management System
            </field>
            <field name="sequence">7</field>
        </record>

        <record id="group_basic_hms_employee" model="res.groups">
            <field name="name">Basic HMS Employee</field>
            <field name="category_id" ref="technortal_hms.module_groups"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hms_manager" model="res.groups">
            <field name="name">HMS Manager</field>
            <field name="category_id" ref="technortal_hms.module_groups"/>
            <field name="implied_ids" eval="[(4, ref('technortal_hms.group_basic_hms_employee'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <!--            [(0,0,{'name':"ABC"})]-->
        </record>

        <record id="basic_employee_room_read_rule" model="ir.rule">
            <field name="name">Show available rooms to basic employees</field>
            <field name="model_id" ref="technortal_hms.model_hms_room"/>
            <field name="domain_force">[('state', '=', 'available')]</field>
            <field name="groups" eval="[(4, ref('technortal_hms.group_basic_hms_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="manager_employee_room_record_rule" model="ir.rule">
            <field name="name">Show available rooms to basic employees</field>
            <field name="model_id" ref="technortal_hms.model_hms_room"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('technortal_hms.group_hms_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
